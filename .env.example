# npm run setup creates a private .env with random local credentials.
DATABASE_URL=postgresql://agent_os:CHANGE_ME@127.0.0.1:55432/agent_os
DB_PASSWORD=CHANGE_ME
APP_ORIGIN=http://127.0.0.1:3100
# Optional. Never paste keys into issues or commit .env.
COMPOSIO_API_KEY=
CODEX_BIN=codex

# Optional explicit model selection. Unset uses the Codex CLI default.
CODEX_MODEL=
